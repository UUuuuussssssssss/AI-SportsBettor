X_BEARER_TOKEN=
ANTHROPIC_API_KEY=
NEWS_ENRICHMENT_MODEL=claude-haiku-4-5-20251001
NEWS_ENRICHMENT_VERSION=v1
NEWS_ENRICHMENT_MAX_OUTPUT_TOKENS=1536
NEWS_ENRICHMENT_BATCH_SIZE=2
ENTITY_SWEEP_MODEL=claude-opus-5
ENTITY_SWEEP_MAX_OUTPUT_TOKENS=4096

# Cloud SQL Python Connector with automatic IAM database authentication.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=project-id:region:instance-id
POSTGRES_DB=sportsbettor
CLOUD_SQL_IAM_USER=service-account-name@project-id.iam
CLOUD_SQL_IP_TYPE=PUBLIC

# Local development only. On Compute Engine, use the VM's attached service
# account and leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional alternative when running a local PostgreSQL server. Leave
# CLOUD_SQL_INSTANCE_CONNECTION_NAME unset when using this.
# POSTGRES_DSN=postgresql+psycopg://sportsbettor:sportsbettor@localhost:5432/sportsbettor
